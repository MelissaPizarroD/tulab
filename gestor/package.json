{
  "name": "gestor",
  "version": "1.0.0",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5175 --strictPort\" \"wait-on http://localhost:5175 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build && tsc -p tsconfig.main.json",
    "package": "electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "axios": "^1.20.0",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.tulab.gestor",
    "productName": "TuLab Gestor",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true
    },
    "extraFiles": [
      {
        "from": "config/config.json",
        "to": "config.json"
      }
    ]
  }
}